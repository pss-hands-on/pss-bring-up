import addr_reg_pkg::*;
import plat_pkg::*;

// One timer channel. Registers (raw offsets, for now -- Lab 2 replaces them
// with a register model):
//   0x0 CTRL   bit0=EN  bit1=IRQ_EN
//   0x4 LOAD   reload value
//   0x8 STATUS bit0=DONE (write 1 to clear)
component timer_c {
    // --- State: set once at initialization, read by every operation
    int            id;
    addr_handle_t  base;

    // --- Initialization: bind this instance to its address window
    solve function void initialize(int i, addr_handle_t b) {
        id   = i;
        base = b;
    }

    // --- Operations
    target function void start(bit[32] ticks) {
        write32(make_handle_from_handle(base, 0x8), 1);    // clear DONE
        write32(make_handle_from_handle(base, 0x4), ticks); // LOAD
        write32(make_handle_from_handle(base, 0x0), 1);    // EN
    }

    target function bool is_done() {
        bit[32] sts = read32(make_handle_from_handle(base, 0x8));
        return (sts & 1) != 0;
    }

    // Exercise 1.2: stop a running channel and clear any pending DONE.
    target function void stop() {
        write32(make_handle_from_handle(base, 0x0), 0);    // EN=0
        write32(make_handle_from_handle(base, 0x8), 1);    // clear DONE
    }

    // Exercise 1.3: give up after max_polls. Returns true if DONE was seen.
    target function bool wait_done(int poll_us, int max_polls) {
        int polls = 0;
        while (!is_done()) {
            if (polls == max_polls) {
                return false;
            }
            plat_delay_us(poll_us);
            polls += 1;
        }
        return true;
    }
}
